{
    "manifest_version": 3,
    "name": "StudyMation",
    "version": "0.21",
    "version_name": "v0.21 beta",
    "description": "Frame-by-frame playback, flipping, and grid-analysis for animators.",
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["content.js"],
            "css": ["style/style.css"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
        "resources": ["fonts/*"],
        "matches": ["https://www.youtube.com/*"]
        }
    ]
}
    